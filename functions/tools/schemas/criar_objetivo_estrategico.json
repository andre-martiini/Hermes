{
  "name": "criar_objetivo_estrategico",
  "description": "Cria um objetivo estratégico (pilar, meta, diretrizes, indicadores e marcos)",
  "parameters": {
    "type": "object",
    "properties": {
      "objetivoMacro": {
        "type": "string",
        "description": "Título do objetivo macro"
      },
      "pilar": {
        "type": "string",
        "description": "Pilar do objetivo (padrão 'carreira')"
      },
      "tipoMeta": {
        "type": "string",
        "description": "Tipo da meta (padrão 'relativa_qualitativa')"
      },
      "status": {
        "type": "string",
        "description": "Status do objetivo (padrão 'ativo')"
      },
      "diretrizes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Lista de diretrizes"
      },
      "indicadores": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Lista de indicadores"
      },
      "marcos": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Lista de marcos"
      },
      "metrica_valor_inicial": {
        "type": "number",
        "description": "Valor inicial da métrica"
      },
      "metrica_valor_atual": {
        "type": "number",
        "description": "Valor atual da métrica"
      },
      "metrica_valor_objetivo": {
        "type": "number",
        "description": "Valor alvo da métrica"
      },
      "metrica_unidade": {
        "type": "string",
        "description": "Unidade da métrica"
      },
      "metrica_fonte": {
        "type": "string",
        "description": "Fonte automatica que alimenta a metrica: 'peso' ou 'cintura'. Sem ela o indicador nao inventa numero — reporta que nao ha fonte ligada, em vez de exibir zero."
      },
      "gerida_por_acoes": {
        "type": "boolean",
        "description": "Se o objetivo e servido por acoes vinculadas (padrao) ou por dado que o sistema ja coleta. Objetivo com false fica FORA de toda sugestao de vinculo e de elevacao: ele e servido por telemetria, e propor acao para ele polui a fila e falseia o progresso. Padrao: false para o pilar saude, true para os demais."
      }
    },
    "required": [
      "objetivoMacro"
    ]
  }
}
