# Runtime
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
HERMES_TIMEZONE=America/Sao_Paulo

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+13603172382

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE_NAME=Charon

# Voice gatekeeper (canal Twilio/telefone — senha falada, sem outra forma de autenticar)
HERMES_REQUIRE_VOICE_PASSWORD=false
HERMES_VOICE_SECRET_PHRASE=your_spoken_secret_phrase

# Voice gatekeeper (canal navegador — Firebase ID Token, ver /browser-voice-stream).
# Origens permitidas para o WebSocket do navegador (separadas por virgula); em
# producao, coloque aqui a origem real do app Hermes.
HERMES_VOICE_ALLOWED_ORIGINS=https://your-hermes-app.web.app
# Fallback de UIDs liberados alem da whitelist em Firestore (system/mcp_access.allowed_uids)
HERMES_MCP_ALLOWED_UIDS=
# URL do servidor MCP do Hermes (functions/mcp_server.py) — as tools auditadas
# do MCP entram na sessao de voz com o token do proprio usuario.
HERMES_MCP_URL=https://us-central1-gestao-hermes.cloudfunctions.net/mcpServer
# Encerra a sessao Gemini Live se ficar esse tempo (segundos) sem audio entrando/saindo
HERMES_VOICE_MAX_IDLE_SECONDS=90
# Duracao maxima absoluta de uma sessao de voz (segundos)
HERMES_VOICE_MAX_SESSION_SECONDS=900

# Firebase / Firestore
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
HERMES_DEFAULT_USER_ID=
