# --- Firebase Auth (para autenticar no servidor MCP do Hermes) ---
# Web API Key do projeto Firebase (Console > Configurações do projeto > Geral).
# Nao e secreta no sentido tradicional, mas mantenha o .env fora do git mesmo assim.
FIREBASE_WEB_API_KEY=

# --- Servidor MCP do Hermes (functions/mcp_server.py, fase 1) ---
# URL da Cloud Function mcpServer apos o deploy, ex:
# https://us-central1-gestao-hermes.cloudfunctions.net/mcpServer
HERMES_MCP_URL=

# --- Gemini (raciocinio do copiloto de voz) ---
# Chave pessoal do Gemini API — fica local, nao passa pelo backend do Hermes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- STT local (faster-whisper) ---
# large-v3-turbo: melhor qualidade em pt-BR (~1.5GB de download na 1a execucao).
# small: download menor (~500MB), mais rapido, qualidade um degrau abaixo.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# --- TTS local (Piper) ---
# Nome de voz no formato <lingua>_<REGIAO>-<nome>-<qualidade>. Baixada automaticamente
# na 1a execucao para PIPER_VOICE_DIR.
PIPER_VOICE=pt_BR-faber-medium
PIPER_VOICE_DIR=./voices
PIPER_USE_CUDA=false

# --- Servidor local ---
PORT=8765
