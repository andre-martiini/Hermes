rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Transcrições longas: cada usuário só acessa a própria pasta.
    // O binário é efêmero (criado pelo cliente, expurgado pelo backend após processar).
    match /long_transcriptions/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && (request.resource.contentType.matches('audio/.*')
                        || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    // Transcrição rápida: arquivo efêmero usado para contornar o limite de 32MB
    // de payload das Cloud Functions. O backend baixa, processa e expurga.
    match /quick_transcriptions/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && (request.resource.contentType.matches('audio/.*')
                        || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    // Mídias do WhatsApp capturadas pelo worker local (áudios, imagens, documentos, figurinhas).
    // Leitura permitida para usuário autenticado do Hermes. Escrita apenas via Admin SDK (worker).
    match /whatsapp_media/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Demais caminhos: sem acesso direto pelo cliente (backend usa Admin SDK e ignora regras).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
